# Másold .env.production néven a szerveren. Ne commitold.
# Hosszú, véletlen titkok; a CHANGE_ME értékeket mind cserélni kell.
DB_NAME=diku
DB_USER=diku
DB_PASSWORD=CHANGE_ME_database_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password
# A tunnel token külön fájl: secrets/cloudflared-token (nem környezeti változó).
# 2026-10-22-én ellenőrzött image-ek; frissítésük felügyelt infra-változás.
MARIADB_IMAGE=mariadb:11.4.10@sha256:3b4dfcc32247eb07adbebec0793afae2a8eafa6860ec523ee56af4d3dec42f7f
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.3@sha256:faa8e0a1475f137c910be6025f43c8e4092fdd35461b31e19fd1390657a1ff39
# Csak az üres felhasználótáblánál hoz létre admint. Első belépés után töröld.
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME_admin_email
BOOTSTRAP_ADMIN_NAME=DIKU admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_long_random_password
# Első indításra: admin létrehozása a backend README szerinti bootstrap móddal.
# A local profil soha ne fusson élesben.
